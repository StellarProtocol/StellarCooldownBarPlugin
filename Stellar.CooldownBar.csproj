<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.CooldownBar</RootNamespace>
    <AssemblyName>Stellar.CooldownBar</AssemblyName>
    <Version>2.2.2</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- i18n P2: consumes IPluginServices.Localization (framework 2.1.0). -->
    <PackageReference Include="Stellar.Abstractions"       Version="2.1.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.0.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
  </ItemGroup>

  <!-- Settings-gear icon (read by LogicalName for the mini-HUD header button). Without it the published DLL
       ships iconless and the gear falls back to a blank/placeholder. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/settings-gear.png" LogicalName="Stellar.CooldownBar.settings-gear.png" />
    <!-- English-translated buff name/description dump (game data is Chinese). Loaded by TranslatedBuffText for the
         "Show hidden effects" feature: resolves NameDesign labels for hidden / placeholder-named buffs. -->
    <EmbeddedResource Include="Resources\BuffTable.json" LogicalName="Stellar.CooldownBar.BuffTable.json" />
    <!-- Launcher-tile icon (read by LogicalName for the Stellar-menu entry). -->
    <EmbeddedResource Include="Resources/cooldownbar-icon.png" LogicalName="Stellar.CooldownBar.cooldownbar-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang/en.json" LogicalName="Stellar.CooldownBar.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json" LogicalName="Stellar.CooldownBar.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json" LogicalName="Stellar.CooldownBar.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json" LogicalName="Stellar.CooldownBar.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.CooldownBar.Lang.fil.json" />
  </ItemGroup>
</Project>
