<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.CooldownBar</RootNamespace>
    <AssemblyName>Stellar.CooldownBar</AssemblyName>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions" Version="1.1.1" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="1.1.1" />
  </ItemGroup>

  <!-- Settings-gear icon (read by LogicalName for the mini-HUD header button). Without it the published DLL
       ships iconless and the gear falls back to a blank/placeholder. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/settings-gear.png" LogicalName="Stellar.CooldownBar.settings-gear.png" />
  </ItemGroup>
</Project>
